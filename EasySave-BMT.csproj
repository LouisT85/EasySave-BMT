<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>EasySave_BMT</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Empêche la génération automatique des attributs d’assembly et du TargetFramework,
         car ils sont déjà générés via WriteCodeFragment (voir obj\\..\\EasySave-BMT.AssemblyInfo.cs) -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <!-- On ne veut compiler ici que le mode console (sans Avalonia ni projet de test Avalonia) -->
  <ItemGroup>
    <!-- Exclure tout le code Avalonia du projet console -->
    <Compile Remove="easySave_BMT.Avalonia\**\*.cs" />
    <!-- Exclure explicitement le projet de test Avalonia copié sous le répertoire principal -->
    <Compile Remove="easySave_BMT.Avalonia\EasySaveAvaloniaTest\**\*.cs" />
  </ItemGroup>

</Project>