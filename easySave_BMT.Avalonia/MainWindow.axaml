<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:easySave_BMT.Avalonia.ViewModels"
        x:Class="easySave_BMT.Avalonia.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="EasySave BMT"
        Width="900" Height="700"
        CanResize="true">
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>
  <StackPanel Margin="20" Spacing="10">
    <!-- Statut global -->
    <TextBlock Text="{Binding StatusText}" FontSize="16" />

    <!-- Zone de création d'une nouvelle sauvegarde -->
    <StackPanel Margin="0,10,0,0" Spacing="6">
      <TextBlock Text="Nouvelle sauvegarde" FontWeight="Bold" />
      <TextBox Text="{Binding NewSaveName}" Watermark="Nom de la sauvegarde" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBox Text="{Binding NewSaveSourcePath}" Watermark="Dossier source" Width="400" IsReadOnly="True" />
        <Button Content="Parcourir..." Click="OnBrowseSourceClick" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBox Text="{Binding NewSaveDestinationPath}" Watermark="Dossier destination" Width="400" IsReadOnly="True" />
        <Button Content="Parcourir..." Click="OnBrowseDestinationClick" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBlock Text="Type de sauvegarde :" VerticalAlignment="Center" />
        <ComboBox Width="160"
                  SelectedItem="{Binding SelectedBackupType}">
          <ComboBoxItem Content="Complet" />
          <ComboBoxItem Content="Différentiel" />
        </ComboBox>
        <Button Command="{Binding AddCommand}" Content="➕ Ajouter" HorizontalAlignment="Right" />
      </StackPanel>
    </StackPanel>

    <!-- Configuration (affichée via bouton) -->
    <StackPanel Margin="0,10,0,0" Spacing="6" IsVisible="{Binding IsConfigVisible}">
      <TextBlock Text="Configuration" FontWeight="Bold" />
      <TextBlock Text="Dossier des logs" />
      <TextBox Text="{Binding ConfigLogDirectory}" Width="500" />
      <TextBlock Text="Fichier d'état" />
      <TextBox Text="{Binding ConfigStateFilePath}" Width="500" />
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBlock Text="Langue :" VerticalAlignment="Center" />
        <ComboBox Width="80"
                  SelectedItem="{Binding ConfigLanguage}">
          <ComboBoxItem Content="fr" />
          <ComboBoxItem Content="en" />
        </ComboBox>
        <Button Command="{Binding LoadConfigCommand}" Content="↻ Charger config" />
        <Button Command="{Binding ConfigCommand}" Content="💾 Enregistrer config" />
      </StackPanel>
    </StackPanel>

    <!-- Barre de commandes principales -->
    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,10,0,0">
      <Button Command="{Binding ListCommand}" Content="📋 Rafraîchir la liste" />
      <Button Command="{Binding RemoveCommand}" Content="🗑️ Supprimer la sélection" />
      <Button Command="{Binding LaunchCommand}" Content="🚀 Lancer backup de la sélection" />
      <Button Command="{Binding ToggleConfigCommand}" Content="⚙️ Config" />
      <Button Command="{Binding QuitCommand}" Content="❌ Quitter" />
    </StackPanel>

    <!-- Progression -->
    <ProgressBar Value="{Binding ProgressPercent}" Height="20" Margin="0,10,0,0" />
    <TextBlock Text="{Binding ProgressText}" />

    <!-- Liste des sauvegardes -->
    <ListBox ItemsSource="{Binding Saves}"
             SelectedItem="{Binding SelectedSave}"
             MinHeight="260"
             Margin="0,10,0,0">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding name}" FontWeight="Bold" />
            <TextBlock Text="{Binding src}" />
            <TextBlock Text="{Binding backupType}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </StackPanel>
</Window>
