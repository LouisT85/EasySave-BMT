<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:easySave_BMT.Avalonia.ViewModels"
        x:Name="Root"
        x:CompileBindings="False"
        x:Class="easySave_BMT.Avalonia.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="EasySave BMT - Dashboard"
        Width="1000" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBackground}">

	<Design.DataContext>
		<vm:MainWindowViewModel />
	</Design.DataContext>

	<Grid ColumnDefinitions="260,*">

		<Border Grid.Column="0" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
			<StackPanel Margin="24,24,24,16" Spacing="6">
				<TextBlock Text="EasySave" FontWeight="Bold" FontSize="22"/>
				<TextBlock Text="{Binding Loc[UiAppSubtitle]}" FontSize="12" Foreground="{DynamicResource BrushMuted}"/>
			</StackPanel>
		</Border>

		<TabControl Grid.Column="0" Grid.ColumnSpan="2" TabStripPlacement="Left" Padding="0" Background="Transparent"
					SelectedIndex="{Binding SelectedTabIndex}">
			<TabControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel Background="{DynamicResource BrushSurface}" Width="260" Margin="0,96,0,0"/>
				</ItemsPanelTemplate>
			</TabControl.ItemsPanel>

			<TabItem Header="{Binding Loc[BackupList]}">
				<Grid RowDefinitions="Auto,*,Auto" Margin="32">
					<StackPanel Grid.Row="0" Margin="0,0,0,20" Spacing="6">
						<TextBlock Text="{Binding Loc[UiDashboardTitle]}" FontSize="26" FontWeight="Bold"/>
						<TextBlock Text="{Binding Loc[UiDashboardSubtitle]}" Foreground="{DynamicResource BrushMuted}"/>
					</StackPanel>

					<!-- Right-click on the blank area of the list container clears the selection -->
					<Border Grid.Row="1" Classes="card" Padding="0" PointerPressed="OnDashboardPointerPressed">
						<ScrollViewer>
							<ListBox ItemsSource="{Binding Saves}" SelectedItem="{Binding SelectedSave}" SelectedItems="{Binding SelectedSaves}" SelectionMode="Multiple" Background="Transparent" BorderThickness="0">
							<ListBox.Styles>
								<Style Selector="ListBoxItem">
									<Setter Property="Padding" Value="0"/>
									<Setter Property="Margin" Value="12,10,12,0"/>
									<Setter Property="Background" Value="Transparent"/>
								</Style>
								<Style Selector="ListBoxItem:pointerover Border.saveItem">
									<Setter Property="Background" Value="{DynamicResource BrushBackground}"/>
								</Style>
								<Style Selector="ListBoxItem:selected Border.saveItem">
									<Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
									<Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
								</Style>
							</ListBox.Styles>
							<ListBox.ItemTemplate>
								<DataTemplate>
									<Border Classes="saveItem" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="14">
										<Grid ColumnDefinitions="6,*,Auto" RowDefinitions="Auto,Auto">
											<Rectangle Grid.Column="0" Grid.RowSpan="2" Fill="{DynamicResource BrushAccent}" RadiusX="3" RadiusY="3"/>

											<StackPanel Grid.Column="1" Grid.Row="0" Margin="12,0,0,0" Spacing="2">
												<TextBlock Text="{Binding name}" FontWeight="Bold" FontSize="16"/>
												<TextBlock Text="{Binding backupType, Converter={StaticResource BackupTypeToLocalizedStringConverter}}" FontSize="12" Foreground="{DynamicResource BrushMuted}"/>
											</StackPanel>

											<StackPanel Grid.Column="1" Grid.Row="1" Margin="12,6,0,0" Spacing="2">
												<StackPanel Orientation="Horizontal" Spacing="4">
													<TextBlock Text="{Binding #Root.DataContext.Loc[Source], StringFormat='{}{0}: '}" FontSize="12" Foreground="{DynamicResource BrushMuted}"/>
													<TextBlock Text="{Binding src}" FontSize="12" Foreground="{DynamicResource BrushMuted}" TextTrimming="CharacterEllipsis"/>
												</StackPanel>
												<StackPanel Orientation="Horizontal" Spacing="4">
													<TextBlock Text="{Binding #Root.DataContext.Loc[Destination], StringFormat='{}{0}: '}" FontSize="12" Foreground="{DynamicResource BrushMuted}"/>
													<TextBlock Text="{Binding dst}" FontSize="12" Foreground="{DynamicResource BrushMuted}" TextTrimming="CharacterEllipsis"/>
												</StackPanel>
											</StackPanel>

											<StackPanel Grid.Column="2" Grid.Row="0" HorizontalAlignment="Right" Margin="16,0,0,0">
												<TextBlock Text="{Binding #Root.DataContext.Loc[UiLastBackup]}" FontSize="10" Foreground="{DynamicResource BrushMuted}"/>
												<TextBlock Text="{Binding lastBackupDate}" FontWeight="SemiBold"/>
											</StackPanel>

											<ProgressBar Grid.Column="2" Grid.Row="1" Width="140" Margin="16,8,0,0"
                                                         Value="{Binding UiProgressPercent}" Maximum="100"/>
										</Grid>
									</Border>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
						</ScrollViewer>
					</Border>

					<Border Grid.Row="2" Classes="card" Margin="0,16,0,0">
						<Grid ColumnDefinitions="*, Auto">
							<StackPanel Orientation="Vertical" VerticalAlignment="Center">
								<TextBlock Text="{Binding DashboardMessage}" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}" TextWrapping="Wrap"/>
								<TextBlock Text="{Binding DashboardStatusText}" FontSize="12" Foreground="{DynamicResource BrushMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
								<StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
									<TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{DynamicResource BrushMuted}"/>
									<ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Width="220" VerticalAlignment="Center" IsVisible="{Binding IsProgressVisible}"/>
								</StackPanel>
							</StackPanel>

							<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
								<Button Classes="ghost" Command="{Binding ListCommand}" Content="{Binding Loc[UiRefresh]}"/>
								<Button Classes="ghost" Command="{Binding SelectAllCommand}" Content="{Binding Loc[UiSelectAll]}"/>
								<Button Classes="danger" Command="{Binding RemoveCommand}" Content="{Binding Loc[UiDelete]}"/>
								<Button Classes="ghost icon" Command="{Binding PauseCommand}" Content="{Binding PauseButtonSymbol}" IsEnabled="{Binding IsBackupRunning}" ToolTip.Tip="{Binding PauseButtonText}"/>
								<Button Classes="danger icon" Command="{Binding StopCommand}" Content="{Binding StopButtonSymbol}" IsEnabled="{Binding IsBackupRunning}" ToolTip.Tip="{Binding Loc[UiStop]}"/>
								<Button Classes="primary" Command="{Binding LaunchCommand}" Content="{Binding Loc[UiRun]}"/>
							</StackPanel>
						</Grid>
					</Border>
				</Grid>
			</TabItem>

			<TabItem Header="{Binding Loc[BackupSettings]}">
				<Grid Margin="32" RowDefinitions="Auto,Auto,*">
					<TextBlock Text="{Binding Loc[UiCreateBackupTitle]}" FontSize="24" FontWeight="Bold" Margin="0,0,0,24"/>

					<Border Grid.Row="1" Classes="card" Background="{DynamicResource BrushAccentSoft}" Margin="0,0,0,16"
							IsVisible="{Binding IsNewTaskBannerVisible}">
						<StackPanel>
							<TextBlock Text="{Binding NewTaskMessage}" Foreground="{DynamicResource BrushAccent}" TextWrapping="Wrap"/>
							<TextBlock Text="{Binding NewTaskStatusText}" FontSize="12" Foreground="{DynamicResource BrushMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
						</StackPanel>
					</Border>

					<Border Grid.Row="2" Classes="card" Padding="24" VerticalAlignment="Top">
						<StackPanel Spacing="16">
							<StackPanel>
								<TextBlock Text="{Binding Loc[UiTaskName]}" FontWeight="SemiBold" Margin="0,0,0,8"/>
								<TextBox Text="{Binding NewSaveName}" Watermark="{Binding Loc[UiTaskNameHint]}"/>
							</StackPanel>

							<Grid ColumnDefinitions="*, 120">
								<StackPanel Grid.Column="0">
									<TextBlock Text="{Binding Loc[Source]}" FontWeight="SemiBold" Margin="0,0,0,8"/>
									<TextBox Text="{Binding NewSaveSourcePath}" Watermark="C:\Users\..." IsEnabled = "False"/>
								</StackPanel>
								<Button Grid.Column="1" Content="{Binding Loc[UiChoose]}" Margin="10,26,0,0" Command="{Binding BrowseSourceCommand}"/>
							</Grid>

							<Grid ColumnDefinitions="*, 120">
								<StackPanel Grid.Column="0">
									<TextBlock Text="{Binding Loc[Destination]}" FontWeight="SemiBold" Margin="0,0,0,8"/>
									<TextBox Text="{Binding NewSaveDestinationPath}" Watermark="D:\Backup\..." IsEnabled = "False"/>
								</StackPanel>
								<Button Grid.Column="1" Content="{Binding Loc[UiChoose]}" Margin="10,26,0,0" Command="{Binding BrowseDestinationCommand}"/>
							</Grid>

							<StackPanel>
								<TextBlock Text="{Binding Loc[Type]}" FontWeight="SemiBold" Margin="0,0,0,8"/>
								<ComboBox ItemsSource="{Binding BackupTypeOptions}" SelectedItem="{Binding SelectedBackupTypeItem}" DisplayMemberBinding="{Binding Display}" HorizontalAlignment="Stretch"/>
							</StackPanel>

							<Button Classes="primary" Command="{Binding AddCommand}" Content="{Binding Loc[UiAddBackup]}" HorizontalAlignment="Right" Margin="0,12,0,0"/>
						</StackPanel>
					</Border>
				</Grid>
			</TabItem>

			<TabItem Header="{Binding Loc[UiLogs]}">
				<Grid ColumnDefinitions="300, *" Margin="24">
					<Border Grid.Column="0" Classes="card" Margin="0,0,16,0" Padding="12">
						<Grid RowDefinitions="Auto, *, Auto">
							<TextBlock Text="{Binding Loc[UiLogFiles]}" FontWeight="Bold" Margin="0,0,0,10"/>
							<ListBox Grid.Row="1" ItemsSource="{Binding LogFiles}" SelectedItem="{Binding SelectedLogFile}">
								<ListBox.Styles>
									<Style Selector="ListBoxItem">
										<Setter Property="Padding" Value="8"/>
									</Style>
									<Style Selector="ListBoxItem /template/ ContentPresenter">
										<Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
									</Style>
									<Style Selector="ListBoxItem:selected /template/ ContentPresenter">
										<Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
										<Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
									</Style>
									<Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
										<Setter Property="Background" Value="#23344A"/>
										<Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
									</Style>
								</ListBox.Styles>
							</ListBox>
							<Button Grid.Row="2" Classes="ghost" Command="{Binding LoadLogsCommand}" Content="{Binding Loc[UiRefresh]}" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
						</Grid>
					</Border>

					<Border Grid.Column="1" Classes="card" Padding="16">
						<ScrollViewer>
							<Border Background="{DynamicResource BrushBackground}" CornerRadius="8" Padding="12">
								<TextBlock Text="{Binding SelectedLogContent}" FontFamily="Cascadia Mono, Consolas, Monospace" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap"/>
							</Border>
						</ScrollViewer>
					</Border>
				</Grid>
			</TabItem>

			<TabItem Header="{Binding Loc[Configuration]}">
				<StackPanel Margin="32" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
					<TextBlock Text="{Binding Loc[CurrentConfiguration]}" FontSize="24" FontWeight="Bold"/>

					<Border Classes="card" Background="{DynamicResource BrushAccentSoft}"
							IsVisible="{Binding IsConfigBannerVisible}">
						<TextBlock Text="{Binding ConfigMessage}" Foreground="{DynamicResource BrushAccent}" TextWrapping="Wrap"/>
					</Border>

					<Border Classes="card">
						<StackPanel Spacing="14">
							<StackPanel Spacing="6">
								<TextBlock Text="{Binding Loc[LogDirectory]}" FontWeight="SemiBold"/>
								<Grid ColumnDefinitions="*,120">
									<TextBox Grid.Column="0" Text="{Binding ConfigLogDirectory}" Watermark="C:\ProgramData\EasySave\Logs" IsEnabled = "False"/>
									<Button Grid.Column="1" Margin="10,0,0,0" Content="{Binding Loc[UiChoose]}" Command="{Binding BrowseLogDirectoryCommand}"/>
								</Grid>
							</StackPanel>

							<StackPanel Spacing="6">
								<TextBlock Text="{Binding Loc[StateFile]}" FontWeight="SemiBold"/>
								<Grid ColumnDefinitions="*,120">
									<TextBox Grid.Column="0" Text="{Binding ConfigStateFilePath}" Watermark="C:\ProgramData\EasySave\state.json" IsEnabled = "False"/>
									<Button Grid.Column="1" Margin="10,0,0,0" Content="{Binding Loc[UiChoose]}" Command="{Binding BrowseStateFilePathCommand}"/>
								</Grid>
							</StackPanel>

							<StackPanel Spacing="6">
								<TextBlock Text="{Binding Loc[Language]}" FontWeight="SemiBold"/>
								<ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding ConfigLanguageDraft}" HorizontalAlignment="Stretch"/>
							</StackPanel>

							<StackPanel Spacing="6">
								<TextBlock Text="{Binding Loc[UiBusinessSoftware]}" FontWeight="SemiBold"/>
								<TextBlock Text="{Binding Loc[UiBusinessSoftwareHelp]}" Foreground="{DynamicResource BrushMuted}" FontSize="12"/>
								<Grid ColumnDefinitions="*,120" Margin="0,2,0,0">
									<TextBox Grid.Column="0" Text="{Binding NewBusinessSoftwareEntry}" Watermark="{Binding Loc[UiBusinessSoftwareHint]}"/>
									<Button Grid.Column="1" Margin="10,0,0,0" Content="{Binding Loc[UiAdd]}" Command="{Binding AddBusinessSoftwareEntryCommand}"/>
								</Grid>
								<Grid ColumnDefinitions="*,120">
									<ListBox Grid.Column="0" ItemsSource="{Binding ConfigBusinessSoftwareEntriesDraft}" SelectedItem="{Binding SelectedBusinessSoftwareEntry}" Height="90"/>
									<Button Grid.Column="1" Margin="10,0,0,0" Content="{Binding Loc[UiRemove]}" Command="{Binding RemoveBusinessSoftwareEntryCommand}"/>
								</Grid>
							</StackPanel>

							<Border Background="{DynamicResource BrushBackground}" CornerRadius="8" Padding="12" Margin="0,6,0,0">
								<StackPanel Spacing="10">
									<TextBlock Text="{Binding Loc[UiEncryptionTitle]}" FontWeight="SemiBold"/>
									<CheckBox Content="{Binding Loc[UiEnableEncryption]}" IsChecked="{Binding ConfigEnableEncryptionDraft}"/>

									<TextBlock Text="{Binding Loc[UiEncryptExtensions]}" Foreground="{DynamicResource BrushMuted}" FontSize="12"/>

									<Grid ColumnDefinitions="*,120" Margin="0,2,0,0">
										<TextBox Grid.Column="0" Text="{Binding NewEncryptionExtension}" Watermark="{Binding Loc[UiExtensionHint]}"/>
										<Button Grid.Column="1" Margin="10,0,0,0" Content="{Binding Loc[UiAdd]}" Command="{Binding AddEncryptionExtensionCommand}"/>
									</Grid>

									<Grid ColumnDefinitions="*,120">
										<ListBox Grid.Column="0" ItemsSource="{Binding ConfigEncryptionExtensionsDraft}" SelectedItem="{Binding SelectedEncryptionExtension}" Height="110"/>
										<Button Grid.Column="1" Margin="10,0,0,0" Content="{Binding Loc[UiRemove]}" Command="{Binding RemoveEncryptionExtensionCommand}"/>
									</Grid>
								</StackPanel>
							</Border>
						</StackPanel>
					</Border>

					<StackPanel Orientation="Horizontal" Spacing="10">
						<Button Classes="ghost" Command="{Binding LoadConfigCommand}" Content="{Binding Loc[UiReload]}"/>
						<Button Classes="primary" Command="{Binding ConfigCommand}" Content="{Binding Loc[UiSave]}"/>
					</StackPanel>

					<Button Classes="danger" Command="{Binding QuitCommand}" Content="{Binding Loc[Quit]}" Margin="0,28,0,0"/>
				</StackPanel>
			</TabItem>

		</TabControl>
	</Grid>
</Window>
