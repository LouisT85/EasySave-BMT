<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Empêche les doublons d'attributs d'assembly / TargetFramework -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <!-- Désactive le générateur x:Name qui échoue sur le projet de test copié -->
    <AvaloniaNameGenerator>false</AvaloniaNameGenerator>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**"/>
  </ItemGroup>

  <!-- Ne pas compiler le projet de test EasySaveAvaloniaTest dans cette assembly -->
  <ItemGroup>
    <Compile Remove="EasySaveAvaloniaTest\**\*.cs" />
  </ItemGroup>

  <!-- Et ne pas inclure les XAML du projet de test dans la compilation Avalonia -->
  <ItemGroup>
    <AvaloniaXaml Remove="EasySaveAvaloniaTest\**\*.axaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.0" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Référence le projet console principal pour réutiliser Model / ViewModel -->
    <ProjectReference Include="..\EasySave-BMT.csproj" />
  </ItemGroup>
</Project>
